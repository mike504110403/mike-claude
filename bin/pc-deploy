#!/bin/bash
# pc-deploy <group> [up|down|status|frontend-up|frontend-down] [--skip-push] [--skip-sync]
#   把「PC 模式起棧」的四步收成一個指令（spec ~/.claude/plans/pc-offload.md §3.3；2026-09-17 起取代 /local-stack 步驟 0 的手工串接）：
#     pc-reach → 對宣告檔 pc.repos 逐一 pc-push → pc-sync-stack <group> → ssh 帶 pc.env 執行宣告檔的 up/down/status
#   所有專案知識都從 ~/Documents/kabo/<group>/.claude/localstack.json 的 pc 區塊與 commands 讀，本腳本零專案分支。
#   exit 0＝該動作在 PC 成功；exit 1＝PC 不可達或宣告檔無 pc 區塊（呼叫端退 Mac 模式）；exit 2＝參數／宣告檔問題；
#   exit 3＝pc-push／pc-sync-stack 失敗；其餘＝遠端指令的 exit code。
#   up：推碼＋同步＋遠端 up；frontend-up：只推前端 repo（宣告檔 frontend 區塊的 repo_path）＋同步；down／status／frontend-down：只同步（腳本住 localstack/，
#   Mac 改了要讓 PC 跑到新版）不推碼。--skip-push／--skip-sync 各自略過。
#   輸出第一行固定「棧：PC（<host>）」或「棧：Mac（<原因>）」供 /local-stack 直接引用。
set -uo pipefail
group="${1:?用法：pc-deploy <group> [up|down|status|frontend-up|frontend-down] [--skip-push] [--skip-sync]}"; shift
action=up; skip_push=0; skip_sync=0
for a in "$@"; do
  case "$a" in
    up|down|status|frontend-up|frontend-down) action="$a" ;;
    --skip-push) skip_push=1 ;;
    --skip-sync) skip_sync=1 ;;
    *) echo "pc-deploy: 未知參數 $a" >&2; exit 2 ;;
  esac
done
src="$HOME/Documents/kabo/$group"; decl="$src/.claude/localstack.json"
[ -f "$decl" ] || { echo "pc-deploy: 找不到 $decl" >&2; exit 2; }
host=$(jq -r '.pc.host // empty' "$decl"); pcroot=$(jq -r '.pc.root // empty' "$decl")
[ -n "$host" ] && [ -n "$pcroot" ] || { echo "棧：Mac（${decl} 無 pc 區塊）"; exit 1; }

if ! reason=$("$HOME/.claude/bin/pc-reach" "$host" 2>&1); then echo "棧：Mac（${reason}）"; exit 1; fi
echo "棧：PC（${host}）"
pcip=$(ssh -G -o RequestTTY=no "$host" | awk '/^hostname /{print $2}')

# 宣告檔的 root 可能是 /Users/mike/documents 或 /Users/mike/Documents（Mac 不分大小寫），cmd 裡兩種都換成 pc.root
macroot=$(jq -r '.root // empty' "$decl")
to_pc_path() { sed -e "s#${macroot:-/nonexistent-root}#$pcroot#g" -e "s#/Users/mike/[Dd]ocuments/kabo/$group#$pcroot#g" <<<"$1"; }
envstr=$(jq -r '.pc.env // {} | to_entries[] | "\(.key)=\(.value|@sh)"' "$decl" | tr '\n' ' ')
remote() { # remote <cmd>：在 pc.root 下、帶 pc.env 執行
  ssh -o BatchMode=yes -o RequestTTY=no "$host" "cd '$pcroot' && export PATH=\$PATH:/usr/local/go/bin && env $envstr $1"
}

push_one() { # push_one <repo-dir>：失敗即 exit 3（不讓 PC 起舊碼）
  local out prc
  out=$("$HOME/.claude/bin/pc-push" "$1" 2>&1); prc=$?
  grep -E '^pc-push: 推|remote:|error|fatal' <<<"$out" || true
  [ "$prc" = 0 ] || { echo "pc-deploy: $1 推送失敗（exit ${prc}）：$(tail -3 <<<"$out")" >&2; exit 3; }
}
# up：推 pc.repos 全部；frontend-up：只推宣告檔 frontend 區塊列的前端 repo（repo_path，單一或 repos[]）；其餘不推
if [ "$skip_push" = 0 ]; then
  case "$action" in
    up) repos=$(jq -r '.pc.repos[]? // empty' "$decl") ;;
    frontend-up) repos=$(jq -r '[.frontend.repo_path?, .frontend.repos[]?.repo_path?] | map(select(. != null)) | .[]' "$decl") ;;
    *) repos="" ;;
  esac
  while IFS= read -r r; do [ -n "$r" ] && push_one "$r"; done <<<"$repos"
fi
# 同步 localstack/ 與宣告檔：所有動作都做（down/status/frontend 腳本都住 localstack/，Mac 改了要讓 PC 跑到新版）
if [ "$skip_sync" = 0 ]; then
  "$HOME/.claude/bin/pc-sync-stack" "$group" | tail -1 || { echo "pc-deploy: pc-sync-stack $group 失敗" >&2; exit 3; }
fi

case "$action" in
  up)     cmd=$(to_pc_path "$(jq -r '.commands.up.cmd' "$decl")") ;;
  down)   cmd=$(to_pc_path "$(jq -r '.commands.down.cmd' "$decl")") ;;
  status) cmd=$(to_pc_path "$(jq -r '.ready_check.cmd // .commands.status.cmd' "$decl")") ;;   # 與 /local-stack 的就緒判準同源
  frontend-up|frontend-down)
    fe=$(jq -r '[.. | .stack_cmd? // empty][0] // empty' "$decl" | awk '{print $1}')
    [ -n "$fe" ] || { echo "pc-deploy: $group 宣告檔無 frontend stack_cmd" >&2; exit 2; }
    cmd="$fe ${action#frontend-}" ;;
esac
remote "$cmd"; rc=$?
if [ "$action" = up ] && [ "$rc" = 0 ]; then
  echo "pc-deploy: ${group} 就緒於 PC ${pcip}（port 依宣告檔 pc.env：${envstr}）"
fi
exit $rc
