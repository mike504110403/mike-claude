#!/bin/bash
# pc-sync-stack <group> — 把 ~/Documents/kabo/<group>/localstack/ 與 .claude/localstack.json rsync 到 PC 同構路徑（spec §3.2）。
# 排除 logs／run／bin／httpLogs／oss-store／*.log（PC 端自己產）。
set -euo pipefail
host="${PC_HOST:-ai-pc-wsl}"
g="${1:?用法：pc-sync-stack <group>（lottery | gold-price | gold-recycle）}"
src="$HOME/Documents/kabo/$g"
dst="ai-gateway/$g"
[ -d "$src/localstack" ] || { echo "pc-sync-stack: 找不到 $src/localstack" >&2; exit 2; }
[ -f "$src/.claude/localstack.json" ] || { echo "pc-sync-stack: 找不到 $src/.claude/localstack.json" >&2; exit 2; }
ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "mkdir -p '$dst/localstack' '$dst/.claude'"
rsync -az --delete \
  --exclude 'logs/' --exclude 'run/' --exclude 'bin/' --exclude 'httpLogs/' --exclude 'oss-store/' --exclude '*.log' \
  "$src/localstack/" "$host:$dst/localstack/"
rsync -az "$src/.claude/localstack.json" "$host:$dst/.claude/localstack.json"
# 宣告檔 pc.extra_sync[]：不在 git 內但棧需要的產生物（如 swag docs），相對 <group> 根的路徑，逐一 rsync 到 PC 同構位置
for rel in $(jq -r '.pc.extra_sync[]? // empty' "$src/.claude/localstack.json"); do
  if [ -e "$src/$rel" ]; then
    ssh -o BatchMode=yes "$host" "mkdir -p '$dst/$(dirname "$rel")'"
    rsync -az "$src/$rel" "$host:$dst/$rel" && echo "  extra_sync: $rel"
  else
    echo "  extra_sync 跳過（Mac 上不存在）：$rel" >&2
  fi
done
# 根路徑改寫（spec §3.3 的 root→pc.root，套用到同步過去的文字設定檔）：
# 宣告檔 root 可能是 /Users/mike/documents 或 /Users/mike/Documents（Mac 檔案系統不分大小寫），兩種都換。
pcroot=$(jq -r '.pc.root // empty' "$src/.claude/localstack.json")
if [ -n "$pcroot" ]; then
  ssh -o BatchMode=yes "$host" "cd '$dst' && grep -rlI '/Users/mike/[Dd]ocuments/kabo/$g' localstack .claude/localstack.json 2>/dev/null | xargs -r sed -i 's#/Users/mike/[Dd]ocuments/kabo/$g#$pcroot#g'; echo \"  改寫根路徑 → ${pcroot} : \$(grep -rlI '${pcroot}' localstack .claude 2>/dev/null | wc -l) 個檔\""
fi
echo "pc-sync-stack: $g → $host:$dst"
