#!/bin/bash
# pc-sync-stack <group> — 把 ~/Documents/kabo/<group>/localstack/ 與 .claude/localstack.json rsync 到 PC 同構路徑（spec §3.2）。
# 排除 logs／run／bin／httpLogs／oss-store／*.log（PC 端自己產）。
set -euo pipefail
host="${PC_HOST:-ai-pc-wsl}"
g="${1:?用法：pc-sync-stack <group>（lottery | gold-price | gold-recycle）}"
src="$HOME/Documents/kabo/$g"
dst="ai-gateway/$g"
[ -d "$src/localstack" ] || { echo "pc-sync-stack: 找不到 $src/localstack" >&2; exit 2; }
[ -f "$src/.claude/localstack.json" ] || { echo "pc-sync-stack: 找不到 $src/.claude/localstack.json" >&2; exit 2; }
ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "mkdir -p '$dst/localstack' '$dst/.claude'"
rsync -az --delete \
  --exclude 'logs/' --exclude 'run/' --exclude 'bin/' --exclude 'httpLogs/' --exclude 'oss-store/' --exclude '*.log' \
  "$src/localstack/" "$host:$dst/localstack/"
rsync -az "$src/.claude/localstack.json" "$host:$dst/.claude/localstack.json"
echo "pc-sync-stack: $g → $host:$dst"
