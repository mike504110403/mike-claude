#!/bin/bash
# 工作流階段檔：跟著 claude session 走（~/.claude/phases/<CLAUDE_CODE_SESSION_ID>）
# 顯示端在 ~/.claude/statusline-dispatch.sh（statusline 刷新時附加 phase 段）
# 用法：
#   phase set 'feature brief▸派工▸[驗收]▸review▸commit'   # 在 claude session 內執行
#   phase clear                                            # lane 收尾刪檔
#   phase show [session_id]                                # statusline 用（stdin JSON 的 session_id 傳入）
dir="$HOME/.claude/phases"

key_for() {
  if [ -n "$1" ]; then printf '%s' "$1"
  elif [ -n "$CLAUDE_CODE_SESSION_ID" ]; then printf '%s' "$CLAUDE_CODE_SESSION_ID"
  else printf 'default'
  fi
}

# cmux 內同步 workspace 狀態徽章（sidebar 可見）；非 cmux 環境靜默跳過
cmux_sync() {
  [ -n "$CMUX_BUNDLED_CLI_PATH" ] && [ -x "$CMUX_BUNDLED_CLI_PATH" ] || return 0
  if [ "$1" = set ]; then
    "$CMUX_BUNDLED_CLI_PATH" set-status phase "$2" --color '#ffc777' >/dev/null 2>&1
  else
    "$CMUX_BUNDLED_CLI_PATH" clear-status phase >/dev/null 2>&1
  fi
}

case "$1" in
  set)
    mkdir -p "$dir"
    printf '%s\n' "$2" > "$dir/$(key_for)"
    cmux_sync set "$2"
    ;;
  clear)
    rm -f "$dir/$(key_for)"
    cmux_sync clear
    ;;
  show)
    f="$dir/$(key_for "$2")"
    [ -f "$f" ] || exit 0
    # 超過 6 小時未更新視為殘留，不顯示
    age=$(( $(date +%s) - $(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0) ))
    [ "$age" -lt 21600 ] && head -1 "$f"
    ;;
  *)
    echo "usage: phase set '<text>' | clear | show [session_id]" >&2
    exit 1
    ;;
esac
