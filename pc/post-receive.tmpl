#!/bin/sh
# ai-gateway 接收端 hook（bootstrap-wsl.sh 依 repos.txt 產生，__BARE__／__WORK__ 會被代換）。
# 只認 refs/heads/pc-test：checkout -f 到工作目錄，再 clean -fd 移除快照裡沒有的未追蹤檔（ignored 檔如 node_modules 保留）。
BARE="__BARE__"
WORK="__WORK__"
while read -r _old new ref; do
  [ "$ref" = "refs/heads/pc-test" ] || continue
  echo "[ai-gateway] pc-test $(printf %.10s "$new") -> $WORK"
  mkdir -p "$WORK"
  git --git-dir="$BARE" --work-tree="$WORK" checkout -f pc-test
  git --git-dir="$BARE" --work-tree="$WORK" clean -fd
  # 工作目錄不是 git repo，localstack 腳本靠這個檔知道自己在跑哪個 commit（如 gold-recycle up.sh 的後端快照）
  printf '%s\n' "$new" > "$WORK/.ai-gateway-rev"
  # push 即部署（波 7c）：留旗標給 systemd path unit（ops/deploy.sh 會 debounce 後跑該群 up.sh）
  GROUP="$(basename "$(dirname "$WORK")")"
  mkdir -p "$HOME/ai-gateway/state/deploy-pending" && touch "$HOME/ai-gateway/state/deploy-pending/$GROUP"
  echo "[ai-gateway] checkout done; deploy queued ($GROUP)"
done
