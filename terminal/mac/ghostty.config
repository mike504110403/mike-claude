# cmux 內嵌 Ghostty 也讀這份；改完跑 `cmux reload-config` 熱重載
# 主題由 cmux themes 管（TokyoNight Storm，寫在 app support 的 config.ghostty），這裡只管字體與間距

font-family = "JetBrainsMono Nerd Font"
# 2026-10-07：cmux 0.65 全域放大 120% 也乘到終端，12×1.2≈14
font-size = 12

# 透明＋blur（2026-09-01 grilling Q7）：reload-config 熱載不生效，待 cmux 重啟驗證；
# 重啟後仍不透＝cmux 內嵌 Ghostty 不支援，把這兩行刪掉即可
background-opacity = 0.85
background-blur-radius = 20

# 自訂終端底色（Macchiato 深一階，全螢幕時的打底色；蓋過主題預設 #24273a）
background = #1e2030

# 背景圖（2026-09-01）——contain 完整顯示不裁切；opacity 壓淡保文字可讀，隨口味調；換圖改這行的檔名（2026-09-08 起）
background-image = ~/.config/ghostty/background1.png
background-image-fit = contain
background-image-opacity = 0.4

# 中文/全形字自動 fallback 到系統字體（PingFang TC），不用另設

# 2026-10-07：0.65 更新後字太粗、行距太擠
# linear-corrected 讓淺字深底的筆畫變細（native 會偏粗）
alpha-blending = linear-corrected
# 行距加高 15%
adjust-cell-height = 15%
